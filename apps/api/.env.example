# Copy to .env. Defaults match compose.yaml at the repo root.

PORT=4000
# Web origin, used for CORS and links in emails
WEB_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://carenta:carenta@localhost:5432/carenta

# Admin account created by `pnpm db:seed`. Outside production these fall back to
# admin@carenta.local / Carenta@123; in production both must be set.
ADMIN_EMAIL=admin@carenta.local
ADMIN_PASSWORD=Carenta@123
ADMIN_NAME=

# Valkey (Redis-compatible), used by BullMQ
VALKEY_URL=redis://localhost:6379

# S3-compatible storage: RustFS locally, Cloudflare R2 when deployed
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=carenta
S3_SECRET_ACCESS_KEY=carenta-secret
S3_FORCE_PATH_STYLE=true
# Car photos and avatars, anonymously readable
S3_PUBLIC_BUCKET=carenta-public
S3_PUBLIC_BASE_URL=http://localhost:9000/carenta-public
# Driver licenses and car documents, presigned URLs only
S3_PRIVATE_BUCKET=carenta-private

# SMTP: Mailpit locally (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Carenta <no-reply@carenta.local>"
