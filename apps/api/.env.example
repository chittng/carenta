# Copy to .env. Defaults match compose.yaml at the repo root.
# The API validates these at boot (src/config/env.ts) and refuses to start if one is invalid.

# development | test | production
NODE_ENV=development
PORT=4000
# Web origin, used for CORS and links in emails
WEB_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://carenta:carenta@localhost:5432/carenta

# Number of proxies in front of the API whose X-Forwarded-For is trusted (client IP for
# rate limits). 0 locally; 1 behind a single load balancer such as Railway's.
TRUST_PROXY_HOPS=0

# Signs access tokens. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# Cookie domain when web and API are on sibling subdomains (e.g. .carenta.vn). Leave empty
# locally. Auth cookies are SameSite=Lax, so web and API must be on the same site
# (same registrable domain) or the web app must proxy /api to the API.
COOKIE_DOMAIN=

# Admin account created by `pnpm db:seed`. Outside production these fall back to
# admin@carenta.local / Carenta@123; in production both must be set.
ADMIN_EMAIL=admin@carenta.local
ADMIN_PASSWORD=Carenta@123
ADMIN_NAME=

# Valkey (Redis-compatible), used by BullMQ. rediss:// for TLS.
VALKEY_URL=redis://localhost:6379
# Run the background workers (email, scheduled jobs) in this process
JOBS_WORKER=true

# S3-compatible storage: RustFS locally, Cloudflare R2 when deployed.
# The endpoint must be reachable from the browser (presigned upload/download URLs).
# R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_FORCE_PATH_STYLE=false; set CORS (PUT/GET from WEB_URL) and an "uploads/" 1-day
# expiry rule on the private bucket, as rustfs-init in compose.yaml does locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=carenta
S3_SECRET_ACCESS_KEY=carenta-secret
S3_FORCE_PATH_STYLE=true
# Car photos and avatars, anonymously readable
S3_PUBLIC_BUCKET=carenta-public
S3_PUBLIC_BASE_URL=http://localhost:9000/carenta-public
# Driver licenses, car documents, trip report photos, dispute evidence, chat images,
# and pending uploads; presigned URLs only
S3_PRIVATE_BUCKET=carenta-private

# SMTP: Mailpit locally (UI at http://localhost:8025).
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend,
# SMTP_PASSWORD=<API key>, and MAIL_FROM on a domain verified in Resend.
# Check delivery with: pnpm --filter @carenta/api mail:test you@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Carenta <no-reply@carenta.local>"
