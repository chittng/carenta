    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@carenta/shared": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/nestjs-api-reference": "1.2.37",
    "bullmq": "6.7.5",
    "ioredis": "6.0.0",
    "nestjs-zod": "5.6.0",
    "nodemailer": "10.5.0",
