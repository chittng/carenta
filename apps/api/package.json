    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
